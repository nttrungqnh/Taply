@model SectionCardViewModel
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-green"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2>@if(!string.IsNullOrWhiteSpace(Model.Subtitle)){<p>@Model.Subtitle</p>}</div></div>@if(Model.Items.Count>0){<ul class="taply-bullet-list">@foreach(var item in Model.Items){<li>@item</li>}</ul>}else if(!string.IsNullOrWhiteSpace(Model.Text)){if(Model.Text.Length>150){<details class="taply-expandable"><summary><span class="taply-note-preview">@Model.Text</span><span class="taply-more">Xem thêm</span><span class="taply-less">Thu gọn</span></summary><p class="taply-note">@Model.Text</p></details>}else{<p class="taply-note">@Model.Text</p>}}@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img class="taply-section-image" src="@Model.ImageUrl" alt="" loading="lazy">}@if(!string.IsNullOrWhiteSpace(Model.VideoUrl)){<a class="taply-video-link" href="@Model.VideoUrl" target="_blank" rel="noopener"><i class="bi bi-play-circle"></i> Xem video hướng dẫn</a>}</section>
