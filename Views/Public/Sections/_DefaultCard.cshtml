@model SectionCardViewModel
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-green"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2>@if(!string.IsNullOrWhiteSpace(Model.Subtitle)){<p>@Model.Subtitle</p>}</div></div>@if(Model.Items.Count>0){<ul class="taply-bullet-list">@foreach(var item in Model.Items){<li>@item</li>}</ul>}else if(!string.IsNullOrWhiteSpace(Model.Text)){<p class="taply-note">@Model.Text</p>}@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img class="taply-section-image" src="@Model.ImageUrl" alt="" loading="lazy">}</section>
