@model SectionCardViewModel
<section class="taply-card wifi-card"><div class="taply-card-heading"><span class="taply-card-icon tone-green"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2></div></div><div class="taply-wifi-values">@if(!string.IsNullOrWhiteSpace(Model.Ssid)){<div class="taply-wifi-field"><span>Tên mạng</span><strong>@Model.Ssid</strong></div>}@if(!string.IsNullOrWhiteSpace(Model.Password)){<div class="taply-wifi-field"><span>Mật khẩu</span><strong>@Model.Password</strong></div>}@if(string.IsNullOrWhiteSpace(Model.Ssid)&&string.IsNullOrWhiteSpace(Model.Password)){<p class="taply-note">Chưa có thông tin Wi-Fi. Hãy nhập SSID và mật khẩu trong phần chỉnh sửa trang.</p>}</div></section>
