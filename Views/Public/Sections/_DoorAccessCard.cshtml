@model SectionCardViewModel
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-orange"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2><p>Mã cửa</p></div></div><div class="taply-door-code-row"><strong class="taply-door-code" data-value="@Model.Code" data-sensitive="@Model.IsSensitive.ToString().ToLowerInvariant()">@(Model.IsSensitive ? "•••••" : Model.Code)</strong><div class="taply-inline-actions">@if(Model.IsSensitive){<button class="taply-action taply-action-soft" type="button" data-toggle-sensitive aria-label="Hiện mã"><i class="bi bi-eye"></i><span>Hiện mã</span></button>}<button class="taply-action taply-action-soft" type="button" data-copy="@Model.Code" data-copy-message="Đã sao chép mã cửa" aria-label="Sao chép mã cửa"><i class="bi bi-copy"></i><span>Sao chép mã</span></button></div></div>@if(!string.IsNullOrWhiteSpace(Model.Note)){<p class="taply-note">@Model.Note</p>}</section>
