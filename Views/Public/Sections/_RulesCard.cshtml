@model SectionCardViewModel
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-yellow"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2><p>@(Model.Subtitle ?? "Một vài lưu ý cho kỳ nghỉ")</p></div></div>@if(Model.Items.Count>0){<ul class="taply-bullet-list">@foreach(var item in Model.Items){<li>@item</li>}</ul>}else if(!string.IsNullOrWhiteSpace(Model.Text)){<p class="taply-note">@Model.Text</p>}</section>
