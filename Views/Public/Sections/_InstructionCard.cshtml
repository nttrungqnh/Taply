@model SectionCardViewModel
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-blue"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2>@if(!string.IsNullOrWhiteSpace(Model.Subtitle)){<p>@Model.Subtitle</p>}</div></div>@if(Model.Items.Count>0){<ol class="taply-steps">@for(var i=0;i<Math.Min(3,Model.Items.Count);i++){<li>@Model.Items[i]</li>}</ol>@if(Model.Items.Count>3){<details class="taply-expandable"><summary class="taply-action taply-action-soft"><span class="taply-more">Xem hướng dẫn đầy đủ</span><span class="taply-less">Thu gọn hướng dẫn</span></summary><ol class="taply-steps" start="4">@for(var i=3;i<Model.Items.Count;i++){<li>@Model.Items[i]</li>}</ol></details>}}else if(!string.IsNullOrWhiteSpace(Model.Text)){<p class="taply-note">@Model.Text</p>}@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img class="taply-section-image" src="@Model.ImageUrl" alt="" loading="lazy">}@if(!string.IsNullOrWhiteSpace(Model.VideoUrl)){<a class="taply-video-link" href="@Model.VideoUrl" target="_blank" rel="noopener"><i class="bi bi-play-circle"></i> Xem video</a>}</section>
