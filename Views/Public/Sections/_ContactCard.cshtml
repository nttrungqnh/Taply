@model SectionCardViewModel
@{ var phone = string.IsNullOrWhiteSpace(Model.Phone) ? Model.Zalo : Model.Phone; var zaloNumber = string.IsNullOrWhiteSpace(Model.Zalo) ? phone : Model.Zalo; var digits = System.Text.RegularExpressions.Regex.Replace(zaloNumber ?? "", "[^0-9]", ""); var zaloUrl = string.IsNullOrWhiteSpace(Model.ZaloUrl) && digits.Length > 0 ? $"https://zalo.me/{digits}" : Model.ZaloUrl; }
<section class="taply-card"><div class="taply-card-heading"><span class="taply-card-icon tone-purple"><i class="bi @Model.Icon"></i></span><div><h2>@Model.Title</h2><p>@(Model.Subtitle ?? "Chúng tôi luôn sẵn sàng hỗ trợ")</p></div></div>@if(!string.IsNullOrWhiteSpace(Model.Note)){<p class="taply-note taply-contact-note">@Model.Note</p>}<div class="taply-inline-actions">@if(!string.IsNullOrWhiteSpace(phone)){<a class="taply-action taply-action-primary" href="tel:@System.Text.RegularExpressions.Regex.Replace(phone, "[^0-9+]", "")"><i class="bi bi-telephone"></i>Gọi ngay</a>}@if(!string.IsNullOrWhiteSpace(zaloUrl)){<a class="taply-action taply-action-green" href="@zaloUrl" target="_blank" rel="noopener"><i class="bi bi-chat-dots"></i>Nhắn Zalo</a>}</div></section>
