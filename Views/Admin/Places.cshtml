@model List<Place>
@{ ViewData["Title"]="Địa điểm"; }
<div class="admin-wrap"><header class="admin-top"><a class="brand" href="/admin/places">taply<span>.</span></a><span>Xin chào, @User.Identity?.Name</span><form method="post" action="/admin/logout"><button class="btn btn-sm btn-outline-secondary">Đăng xuất</button></form></header><div class="d-flex justify-content-between align-items-center mt-5 mb-4"><div><h1>Địa điểm của bạn</h1><p class="muted">Quản lý các trang thông tin tại đây.</p></div><button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#placeModal">＋ Tạo địa điểm</button></div><div class="row g-3">@foreach(var p in Model){<div class="col-md-6 col-xl-4"><div class="admin-card"><div class="place-image" style="background-image:url('@(p.CoverImageUrl ?? "")')"><span class="badge bg-white text-dark">@(p.IsActive?"Đang hoạt động":"Đã tắt")</span></div><div class="p-4"><h4>@p.Name</h4><p class="muted">@p.Pages.Count trang · @p.Address</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-dark btn-sm" href="/admin/places/@p.Id">Quản lý trang</a><a class="btn btn-light btn-sm" href="/admin/places/@p.Id/edit">Sửa thông tin</a>@if(p.Pages.FirstOrDefault() is Page pg){<a class="btn btn-light btn-sm" target="_blank" href="/p/@pg.Slug">Mở trang ↗</a>}<form method="post" action="/admin/places/@p.Id/delete" onsubmit="return confirm('Xóa địa điểm?')"><button class="btn btn-light btn-sm text-danger">Xóa</button></form></div></div></div></div>}</div></div>
<div class="modal fade" id="placeModal"><div class="modal-dialog"><form class="modal-content" method="post" action="/admin/places/save" enctype="multipart/form-data"><div class="modal-header"><h5>Tạo địa điểm</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><label>Tên địa điểm</label><input name="name" class="form-control mb-3" required><label>Địa chỉ</label><input name="address" class="form-control mb-3"><label>Điện thoại</label><input name="phone" class="form-control mb-3"><label>Ảnh bìa</label><input type="file" name="cover" accept="image/*" class="form-control"></div><div class="modal-footer"><button class="btn btn-dark">Tạo địa điểm</button></div></form></div></div>
