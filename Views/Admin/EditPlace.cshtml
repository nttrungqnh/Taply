@model Place
@{ ViewData["Title"] = "Sửa địa điểm · " + Model.Name; }
<div class="admin-wrap">
    <a class="muted" href="/admin/places">← Danh sách địa điểm</a>
    <div class="mt-3 mb-4">
        <h1>Sửa thông tin địa điểm</h1>
        <p class="muted">Cập nhật tên, liên hệ và hình ảnh cho @Model.Name.</p>
    </div>
    <form method="post" action="/admin/places/save" enctype="multipart/form-data" class="admin-card p-4">
        <input type="hidden" name="id" value="@Model.Id">
        <div class="row g-3">
            <div class="col-12">
                <label for="placeName">Tên địa điểm</label>
                <input id="placeName" name="name" value="@Model.Name" class="form-control" required maxlength="160">
            </div>
            <div class="col-12">
                <label for="placeAddress">Địa chỉ</label>
                <input id="placeAddress" name="address" value="@Model.Address" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="placePhone">Số điện thoại</label>
                <input id="placePhone" name="phone" type="tel" value="@Model.Phone" class="form-control" placeholder="0912 345 678">
            </div>
            <div class="col-md-6">
                <label for="placeZalo">Zalo</label>
                <input id="placeZalo" name="zalo" value="@Model.Zalo" class="form-control" placeholder="Số điện thoại hoặc link Zalo">
            </div>
            <div class="col-12">
                <label for="placeDescription">Mô tả</label>
                <textarea id="placeDescription" name="description" class="form-control" rows="4">@Model.Description</textarea>
            </div>
            <div class="col-md-6">
                <label for="placeLogo">Logo</label>
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <div class="mb-2"><img src="@Model.LogoUrl" alt="Logo hiện tại" style="width:64px;height:64px;object-fit:cover;border-radius:14px"></div>
                }
                <input id="placeLogo" name="logo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="placeCover">Ảnh bìa</label>
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <div class="mb-2"><img src="@Model.CoverImageUrl" alt="Ảnh bìa hiện tại" style="width:100%;height:64px;object-fit:cover;border-radius:12px"></div>
                }
                <input id="placeCover" name="cover" type="file" accept="image/jpeg,image/png,image/webp" class="form-control">
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input id="placeActive" class="form-check-input" type="checkbox" name="isActive" value="true" checked="@Model.IsActive">
                    <input type="hidden" name="isActive" value="false">
                    <label class="form-check-label" for="placeActive">Địa điểm đang hoạt động</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-dark" type="submit">Lưu thay đổi</button>
            <a class="btn btn-light" href="/admin/places">Hủy</a>
        </div>
    </form>
</div>
